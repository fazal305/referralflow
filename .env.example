# Server-side (used only by the /api serverless functions — never exposed to the browser)
DATABASE_URL=
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Client-side (exposed to the browser — must be prefixed VITE_)
# Base URL used to build public referral links (yourdomain.com/r/CODE).
# Leave blank to fall back to window.location.origin.
VITE_PUBLIC_APP_URL=
