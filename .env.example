# Copy this file to .env.local and fill in your Supabase project values.
# Find these in Supabase Dashboard > Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL used to build public referral links (yourdomain.com/r/CODE).
# Leave blank to fall back to window.location.origin.
VITE_PUBLIC_APP_URL=
